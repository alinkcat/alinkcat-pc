#!/system/bin/sh
# alnkcat_helper - unified entry for the alinkcat root module
# usage: sh alnkcat_helper <cmd> [args...]
# plain POSIX shell, works under Magisk/KSU

VERSION="1.0.0"
MODDIR="/data/adb/modules/alinkcat_module"

# load config
CONF="${0%/*}/../config/module.conf"
[ -f "$CONF" ] && . "$CONF"
[ -f "$MODDIR/config/module.conf" ] && . "$MODDIR/config/module.conf"

# help
usage() {
  echo "usage: alnkcat_helper <cmd> [args]"
  echo ""
  echo "Commands:"
  echo "  version             显示模块版本"
  echo "  daemon              启动守护进程 (后台)"
  echo "  monitor <type>      深层硬件监控 (cpu|battery|all)"
  echo "  action <type> args  执行动作 (shell|service|settings|brightness)"
  echo "  config <get|set>    读写模块配置"
  echo "  secret              输出当前密钥 (仅限 App 调用)"
  echo "  capabilities        列出可用能力"
}

case "$1" in
  version)
    echo "alinkcat-module $VERSION"
    ;;
  capabilities)
    echo "capabilities: monitor action config"
    [ "$ENABLE_POWER" = "1" ] && echo "power"
    [ "$ENABLE_ACCESSIBILITY" = "1" ] && echo "accessibility"
    ;;
  daemon)
    # daemon: keep alive and wait for commands
    while true; do
      sleep 30
      # TODO: listen on a local unix socket here
    done
    ;;
  monitor)
    [ "$ENABLE_MONITOR" != "1" ] && { echo "monitor disabled"; exit 1; }
    shift
    SCRIPT="${0%/*}/../scripts/shell/monitor.sh"
    [ -f "$SCRIPT" ] || SCRIPT="$MODDIR/scripts/monitor.sh"
    . "$SCRIPT"
    get_${1:-all} "${@:2}"
    ;;
  action)
    shift
    [ "$ENABLE_ACTION" != "1" ] && { echo "action disabled"; exit 1; }

    # auth: first arg must be the secret
    local_secret="$1"; shift
    [ "$local_secret" != "$MODULE_SECRET" ] && { echo "permission denied"; exit 1; }

    SCRIPT="${0%/*}/../scripts/shell/action.sh"
    [ -f "$SCRIPT" ] || SCRIPT="$MODDIR/scripts/action.sh"
    . "$SCRIPT"
    run_action "$@"
    ;;
  config)
    shift
    SCRIPT="${0%/*}/../scripts/shell/config.sh"
    [ -f "$SCRIPT" ] || SCRIPT="$MODDIR/scripts/config.sh"
    . "$SCRIPT"
    edit_config "$@"
    ;;
  secret)
    echo "$MODULE_SECRET"
    ;;
  *)
    usage
    ;;
esac