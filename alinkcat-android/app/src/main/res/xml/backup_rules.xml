<?xml version="1.0" encoding="utf-8"?><!--
   Android 自动备份排除规则（API < 31 使用 fullBackupContent）。
   安全要求：ilinkcat_prefs（SharedPreferences）内含明文 weather_api_key，
   DataStore（ailinkcat_config）含配对信息 ip/port/pair_code——均不得进入云备份/设备迁移，防外泄。
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ilinkcat_prefs.xml"/>
    <exclude domain="file" path="datastore/"/>
</full-backup-content>
